POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metabolomics
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/metabolomics

# Generate a strong secret before deploying, e.g. openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional admin account created on first startup. Both must be set.
# ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-this-password

# URL where the frontend is served, used for password reset links and CORS.
# FRONTEND_URL=http://localhost:13457

# Optional S3-compatible object storage. Can also be configured from the admin panel.
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_PATH_STYLE=false
